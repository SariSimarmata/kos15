CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8080/'

database.default.hostname = localhost
database.default.database = db_kos
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3306    

# Midtrans (pembayaran QRIS). Isi di .env, JANGAN di-commit.
# Server Key sandbox: dashboard.sandbox.midtrans.com > Settings > Access Keys (awalan SB-Mid-server-)
# Gateway untuk pembayaran baru: duitku atau midtrans. Production nanti cukup DUITKU_IS_PRODUCTION=true + kunci production
PAYMENT_GATEWAY=duitku

MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Duitku (dashboard > Project). Sandbox: sandbox.duitku.com, Production: passport.duitku.com
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_IS_PRODUCTION=false
# Kode metode QRIS yang aktif di project: SP (ShopeePay), NQ (Nobu), LQ (LinkAja)
DUITKU_METODE_QRIS=SP
# Opsional. Kosong = <baseURL>/pembayaran/callback-duitku. Isi alamat ngrok agar callback sampai ke laptop.
DUITKU_CALLBACK_URL=
DUITKU_EMAIL_PELANGGAN=penghuni@kos15.test
